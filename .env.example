# Application Settings
APP_NAME=Document Understanding API
APP_VERSION=1.0.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Paths (sẽ được tạo tự động nếu chưa tồn tại)
# UPLOAD_DIR=uploads
# OUTPUT_DIR=outputs
# TEMP_DIR=temp
# CHROMA_DB_PATH=chroma_db

# OCR Models
DEEPSEEK_MODEL_NAME=deepseek-ai/DeepSeek-OCR
# LOGO_MODEL_PATH=/path/to/logo_best.pt

# Embedding & Vector Store
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
COLLECTION_NAME=document_collection

# Reranker
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
INITIAL_RETRIEVAL_K=50
RERANK_TOP_K=5

# LLM
LLM_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
LLM_TYPE=local
# GEMINI_API_KEY=your_gemini_api_key_here

# Generation Parameters
MAX_NEW_TOKENS=128
TEMPERATURE=0.1

# Chunking
MAX_CHUNK_SIZE=1024

# Processing
BATCH_SIZE=16
PDF_DPI=200
LOGO_CONFIDENCE_THRESHOLD=0.7

# Device (cuda hoặc cpu)
DEVICE=cuda
